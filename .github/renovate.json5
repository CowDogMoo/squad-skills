{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':disableRateLimiting',
    ':dependencyDashboard',
    ':semanticCommits',
    ':enablePreCommit',
    ':automergeDigest',
    ':automergeBranch',
    'helpers:pinGitHubActionDigests',
  ],
  dependencyDashboardLabels: [
    'renovate-dashboard',
  ],
  dependencyDashboardTitle: 'Renovate Dashboard',
  suppressNotifications: [
    'prIgnoreNotification',
  ],
  rebaseWhen: 'conflicted',
  commitBodyTable: true,
  labels: [
    'renovate',
  ],
  platformAutomerge: true,
  'pre-commit': {
    enabled: true,
  },
  'github-actions': {
    enabled: true,
  },
  packageRules: [
    {
      description: 'Auto merge GitHub Actions updates',
      matchManagers: [
        'github-actions',
      ],
      matchDatasources: [
        'github-tags',
      ],
      matchUpdateTypes: [
        'major',
        'minor',
        'patch',
      ],
      automerge: true,
      automergeType: 'branch',
    },
    {
      // Last so it wins over the automerge rules above and the
      // :automergeDigest/:automergeBranch presets. Anything under .github/
      // decides what CI runs, including the skill-evals job that holds the
      // Claude token, so a human reviews every such update before it lands.
      description: 'Never auto-merge GitHub Actions or anything under .github/',
      matchFileNames: [
        '.github/**',
      ],
      automerge: false,
    },
    {
      description: 'Never auto-merge GitHub Actions updates, wherever the action is used',
      matchManagers: [
        'github-actions',
      ],
      automerge: false,
    },
  ],
}
